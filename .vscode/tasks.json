{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "[StateRP] Make Debug",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "${workspaceRoot}/compiler/git.cmd && ${workspaceRoot}/compiler/pawncc.exe \"${workspaceRoot}\\gamemodes\\staterp.pwn\" -Dgamemodes \"-;+\" \"-(+\" \"-d3\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "isBackground": false,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": "$pawncc"
        },
	]
}
